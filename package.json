{
  "name": "kikoune",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -- turbo dev",
    "build": "turbo build",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxfmt --write && oxlint --fix",
    "typecheck": "turbo run typecheck",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  },
  "devDependencies": {
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "turbo": "^2.7.5"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "picomatch": "4.0.2"
    }
  }
}
